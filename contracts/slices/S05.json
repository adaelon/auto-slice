{
  "id": "S05",
  "contract_version": 1,
  "requires": [
    "S02",
    "S03",
    "S04"
  ],
  "objective": "解析 SliceContractV1，在有效 Project Write Lease 与 DEVELOPMENT ModelDecision 下执行 argv-only 确定性 checks，并以 artifact digest 和 Slice-owned diff 生成不可歧义的 VerificationReceipt。",
  "exclusions": [
    "不执行 Git commit、push 或 checkpoint 刷新",
    "不实现自动压缩监测、Source Interruption 或任务接力",
    "不把 LLM 文本、自述或评分当作验收证据",
    "不允许 shell 字符串、workspace 外 cwd、未列入 allowlist 的环境变量或越界写入"
  ],
  "inputs": [
    {
      "path": "artifacts/s02/completion-receipt.json",
