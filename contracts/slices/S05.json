  ],
  "owned_paths": [
    "contracts/slices/S05.json",
    "src/controller/slices/**",
    "test/slice-executor.test.ts",
    "test/fixtures/process/**",
    "scripts/verify-s05-evidence.mjs",
    "scripts/verify-s05.mjs",
    "package.json",
    "artifacts/s05/**",
    "docs/代码链路.md",
    "docs/架构.md"
  ],
  "ports": [
    {
      "name": "parse_slice_contract",
      "signature": "parseSliceContractV1(input) -> SliceContractV1 | slice_contract_invalid | path_outside_workspace"
    },
    {
      "name": "run_check",
      "signature": "CheckProcessRunner.run(check, workspace) -> CheckExecutionReceipt"
    },
    {
      "name": "start_slice_execution",
      "signature": "SliceExecutor.start(contract, lease, model_decision) -> ExecutionId | SliceExecutionError"
    },
    {
      "name": "collect_slice_execution",
      "signature": "SliceExecutor.collect(execution_id) -> ExecutionReceipt | SliceExecutionError"
    },
    {
      "name": "verify_slice",
      "signature": "SliceVerifier.verify(contract, execution_receipt, workspace) -> VerificationReceipt"
    }
  ],
  "allowed_transitions": [
    "SLICE_RUNNING -> VERIFYING",
    "VERIFYING -> SLICE_VERIFIED",
    "VERIFYING -> SLICE_RUNNING",
    "VERIFYING -> NEEDS_USER"
  ],
  "failure_codes": [
    "slice_contract_invalid",
    "path_outside_workspace",
    "write_capability_unavailable",
    "model_decision_invalid",
    "execution_not_found",
    "execution_already_collected",
    "check_spawn_failed",
    "check_timeout",
    "check_nonzero_exit",
    "check_output_limit_exceeded",
    "artifact_missing",
    "artifact_digest_mismatch",
    "unowned_change_detected",
    "protected_change_overlap",
    "workspace_inspection_failed",
    "verification_receipt_invalid"
  ],
  "checks": [
    {
      "id": "build",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "cwd": ".",
