{
  "id": "S19",
  "contract_version": 1,
  "requires": ["S17", "S18"],
  "objective": "让 CodexAppServerTaskHost 以一个共享且只初始化一次的 App Server client 承载 Source、Compression 与 Continuation root，并提供 fail-closed 的 fresh-root、单 active Turn、顺序 terminal 和 bounded private completed-item session 基座。",
  "exclusions": [
    "不解析或调用 export-codex-handoff skill",
    "不构造 HandoffReceipt 或 ReadyReceipt",
    "不实现 CompressionTaskLauncher 或 ContinuationLauncher 的生产行为",
    "不授予或轮换 Project Write Lease",
    "不把 private item、raw notification 或其正文写入 ControllerSignal、RunStore、日志或错误详情",
    "不调用 thread/resume、thread/fork 或 turn/steer"
  ],
  "inputs": [
    {
      "path": "artifacts/s17/completion-receipt.json",
