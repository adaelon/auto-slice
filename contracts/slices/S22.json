{
  "id": "S22",
  "contract_version": 1,
  "requires": ["S20", "S21"],
  "objective": "以默认 CodexAppServerTaskHost 完成 Source → Compression → Continuation 三任务链的 hermetic 与本机 disposable live 双层验收；Compression completed 后只取最终结果中的第一个 Markdown 文件地址作为 Handoff。",
  "exclusions": [
    "不启动或复用用户真实 Source Run",
    "不连接远端或执行远程 Git",
    "不缩短真实 30 秒 Compaction Timeout、注入假租约或注入 revision provider/launcher",
    "不把 hermetic fixture 成功解释为模型语义质量验收",
    "不把 provider、worker 或 1200 秒预算 blocker 降级为 LIVE_CHAIN_PASS",
    "不从 prepare、Frame、MAP、REDUCE 或 publish helper 命令及其输出构造 HandoffReceiptV2",
    "不读取、校验或持久化 Evidence Index 与 HANDOFF_VERIFY 结果到新 receipt",
    "不读取或持久化 Worker Content 到 Controller、RunStore、日志或验证报告"
  ],
  "inputs": [
    {
      "path": "artifacts/s20/completion-receipt.json",
      "digest": "sha256:6bd0367648ee4226122c0b137a154b92de1b15aee7c4f77fa49cdf4d02764f1d",
      "producer_slice": "S20"
    },
    {
      "path": "artifacts/s21/completion-receipt.json",
      "digest": "sha256:83712fb3baaa7c54f439136c40e237f46ff047f3415840df49fb133fa4660feb",
      "producer_slice": "S21"
    }
  ],
  "owned_paths": [
