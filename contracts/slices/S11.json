    { "name": "project_run_status", "signature": "projectRunSnapshot(run) -> RunSnapshot" },
    { "name": "persist_command_receipt", "signature": "FileCommandJournal.begin/complete(command_id, envelope_digest, receipt)" },
    { "name": "resolve_needs_user", "signature": "ExplicitRecoveryPort.resolve(run, resolution, evidence, command_id) -> RecoveryPortReceipt" }
  ],
  "allowed_transitions": [
    "nonterminal except NEEDS_USER/PAUSED -> PAUSED",
    "PAUSED -> persisted paused_from_status",
    "NEEDS_USER -> last_successful_status with matching explicit resolution",
    "any nonterminal -> ABORTED",
    "pre-VERIFYING target Slice -> same Run status with one commit-mode override"
  ],
  "failure_codes": [
