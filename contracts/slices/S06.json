    "docs/代码链路.md",
    "docs/架构.md"
  ],
  "ports": [
    {
      "name": "finish_slice",
      "signature": "CommitCoordinator.finishSlice(input) -> FinishReceipt | CommitCoordinatorError"
    },
    {
      "name": "atomic_rewrite_checkpoint",
      "signature": "CheckpointWriter.atomicRewrite(workspace, document) -> CheckpointWriteReceipt | CheckpointWriteError"
    }
  ],
  "allowed_transitions": [
    "VERIFYING -> COMMITTING",
    "VERIFYING -> CHECKPOINTING",
    "COMMITTING -> CHECKPOINTING",
    "CHECKPOINTING -> SLICE_RUNNING",
    "CHECKPOINTING -> DONE",
    "COMMITTING -> NEEDS_USER",
