{
  "id": "S06",
  "contract_version": 1,
  "requires": [
    "S03",
    "S05"
  ],
  "objective": "实现 after_slice|none、Slice override、仅提交已验证 OwnedPatch、checkpoint 原子刷新和永不 push 的本地 Git 边界。",
  "exclusions": [
    "不执行 Git push 或任何远端写入",
    "不自动解决冲突、HEAD 竞争或 Protected Change 重叠",
    "不修改 VerificationReceipt 的结果或把失败折算为通过",
    "不实现 S07 自动压缩监测或后续任务接力"
  ],
  "inputs": [
