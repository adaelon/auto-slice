{
  "id": "S02",
  "contract_version": 1,
  "requires": [
    "S01"
  ],
  "objective": "实现 RunState、追加式事件日志、state_version CAS、幂等副作用账本和崩溃恢复。",
  "exclusions": [
    "不调用真实 Codex、Git、进程或文件写租约适配器",
    "不实现业务副作用",
    "不实现 S03 Project Write Lease 或 Protected Change",
    "不实现 S04 Deterministic Model Router"
  ],
  "inputs": [
    {
      "path": "artifacts/s01/completion-receipt.json",
