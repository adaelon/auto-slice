      "producer_slice": "frozen-design"
    }
  ],
  "owned_paths": [
    "contracts/slices/S02.json",
    "src/controller/state/**",
    "test/run-store.test.ts",
    "test/helpers/cas-worker.ts",
    "test/fixtures/state/**",
    "scripts/replay-run-events.mjs",
    "scripts/verify-s02-replay.mjs",
    "scripts/verify-s02.mjs",
    "package.json",
    "artifacts/s02/**",
    "docs/adr/0005-directory-event-store.md",
    "docs/代码链路.md",
    "docs/架构.md"
  ],
  "ports": [
    {
      "name": "create_run",
      "signature": "RunStore.create(initial: RunState) -> StoredRun | StateStoreError"
    },
    {
      "name": "load_run",
      "signature": "RunStore.load(run_id) -> StoredRun | run_not_found | state_corrupt"
    },
    {
      "name": "compare_and_swap",
      "signature": "RunStore.compare_and_swap(run_id, expected_version, transition) -> StoredRun | stale_state | invalid_transition"
    },
    {
      "name": "append_effect_intent",
      "signature": "RunStore.append_effect_intent(idempotency_key, payload_digest) -> EffectRecord | StateStoreError"
    },
    {
      "name": "complete_effect",
      "signature": "RunStore.complete_effect(idempotency_key, receipt_digest) -> EffectRecord | StateStoreError"
    },
    {
      "name": "recover_incomplete_effects",
      "signature": "RunStore.recover_incomplete_effects(run_id) -> EffectRecord[] | StateStoreError"
    },
    {
      "name": "replay_run_events",
      "signature": "RunStore.replay_run_events(run_id) -> RunReplayReport | StateStoreError"
    }
  ],
  "allowed_transitions": [
    "BLOCKED -> READY",
    "READY -> IN_PROGRESS",
    "IN_PROGRESS -> VERIFYING",
    "VERIFYING -> COMPLETE",
    "VERIFYING -> FAILED"
  ],
  "failure_codes": [
    "run_not_found",
    "run_already_exists",
    "invalid_state",
    "invalid_transition",
    "stale_state",
    "state_persist_failed",
    "state_corrupt",
    "unsupported_state_schema"
  ],
  "checks": [
    {
      "id": "build",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "cwd": ".",
