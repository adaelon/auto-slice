        "run",
        "lint"
      ],
      "cwd": ".",
      "timeout_ms": 120000,
      "env_allowlist": [
        "PATH",
        "SystemRoot",
        "ComSpec",
        "PATHEXT",
        "USERPROFILE",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP"
      ],
      "expected_exit_code": 0,
      "expected_artifacts": []
    }
  ],
  "expected_artifacts": [
    {
      "path": "artifacts/s03/concurrency-report.json",
      "kind": "process_race_report"
    },
    {
      "path": "artifacts/s03/git-scenario-matrix.json",
      "kind": "real_git_scenario_matrix"
    },
    {
      "path": "artifacts/s03/lease-event-log.json",
      "kind": "lease_event_log"
    },
    {
      "path": "artifacts/s03/completion-receipt.json",
      "kind": "completion_receipt"
    },
    {
      "path": "docs/代码链路.md",
      "kind": "code_path_index"
    },
    {
      "path": "docs/架构.md",
      "kind": "implementation_architecture"
    }
  ],
  "unlocks": [
    "S05",
    "S06",
    "S08",
    "S10"
  ]
}
