      ],
      "cwd": ".",
      "timeout_ms": 120000,
      "env_allowlist": [
        "PATH",
        "SystemRoot",
        "ComSpec",
        "PATHEXT",
        "USERPROFILE",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP"
      ],
      "expected_exit_code": 0,
      "expected_artifacts": []
    },
    {
      "id": "s03_evidence",
      "argv": [
        "node",
        "scripts/verify-s03-evidence.mjs"
      ],
      "cwd": ".",
      "timeout_ms": 120000,
      "env_allowlist": [
        "PATH",
        "SystemRoot",
        "ComSpec",
        "PATHEXT",
        "USERPROFILE",
        "HOME",
        "APPDATA",
        "LOCALAPPDATA",
        "TEMP",
        "TMP"
      ],
      "expected_exit_code": 0,
      "expected_artifacts": []
