{
  "id": "S15",
  "contract_version": 1,
  "requires": ["S14", "S08", "S09"],
  "objective": "用 Host 边界的定长不透明 revision 与 summary-only ThreadMetadataPort 替代 Controller 的 thread/read(includeTurns=true)，并把 revision 能力失败确定性闭合到 Source interruption 门禁。",
  "exclusions": [
    "不用 updatedAt、单字段时间戳或完整 Thread/turns hash 伪装稳定 revision",
    "不允许 Controller 或 Host Adapter 请求 includeTurns=true、保留正文或接受 summary 中夹带的 turns/items",
    "不改变 Handoff v2 产物格式或 Compression Task 读取 Source Thread 正文的权限",
    "不实现 S16 内容预算端到端门禁",
    "不倒改 S08、S09 或 S14 CompletionReceipt",
    "不执行 Git commit 或 push"
  ],
  "inputs": [
