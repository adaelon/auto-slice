  "ports": [
    {
      "name": "start_continuation_task",
      "signature": "ContinuationLauncher.start(envelope, model_decision) -> ContinuationTaskId | continuation_start_failed"
    },
    {
      "name": "await_continuation_ready",
      "signature": "ContinuationLauncher.awaitReady(task_id) -> ReadyReceipt | continuation_start_failed"
    },
    {
      "name": "grant_continuation_write",
      "signature": "ContinuationLauncher.grantWrite(task_id, new_write_epoch) -> LeaseReceipt | continuation_start_failed"
    },
    {
      "name": "await_continuation_progress",
      "signature": "ContinuationLauncher.awaitProgress(task_id) -> ProgressReceipt | continuation_start_failed"
    },
    {
      "name": "coordinate_continuation",
      "signature": "ContinuationCoordinator.continueFromHandoff(input) -> ContinuationDecision | ContinuationError"
    }
  ],
  "allowed_transitions": [
    "CONTINUATION_STARTING -> SLICE_RUNNING",
    "CONTINUATION_STARTING -> NEEDS_USER"
  ],
