{
  "id": "S10",
  "contract_version": 1,
  "requires": [
    "S03",
    "S04",
    "S09"
  ],
  "objective": "创建与 Source Thread、Compression Task 两两不同的只读 Continuation Task，复验 Handoff 与 workspace 绑定，遵守 synthesize-first consumer contract，授予 S08 已轮换的新 write epoch，并在首个持久进展回执成立后原子恢复同一 Run/Slice。",
  "exclusions": [
    "不复用 Source Thread 或 Compression Task，也不把续接视为新 Slice",
    "不在 ReadyReceipt 与 Handoff 复验成立前授予写权限",
    "不允许 commentary、普通静默或未变化 digest 充当持久进展",
    "不恢复旧 Source 的 write epoch，不创建 S11 控制面",
    "不执行 Git commit 或 push"
  ],
