{
  "id": "S20",
  "contract_version": 1,
  "requires": ["S18", "S19"],
  "objective": "让默认 CodexAppServerTaskHost 以真实 fresh Compression Task 执行 export-codex-handoff，并只从持久 attempt、绑定 command 链、发布字节和 Host verify-evidence 构造 HandoffReceiptV2。",
