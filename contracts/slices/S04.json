{
  "id": "S04",
  "contract_version": 1,
  "requires": [
    "S01"
  ],
  "objective": "把开发、续接、压缩和确定性工作角色严格映射到冻结的模型策略，并在精确模型、reasoning effort 或有效 Host 能力快照不可用时 fail closed。",
  "exclusions": [
    "不调用任何模型或模型 provider",
    "不比较模型性能或动态优化路由",
    "不允许相似模型、较低 reasoning effort 或默认策略 fallback",
    "不执行 Slice、自动压缩或任务接力"
  ],
